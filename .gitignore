# environment (recreate with ./setup.sh — needed once per fresh sandbox)
.venv/
bin/
# local font downloads, preview stills and quran-subtitles smoke-test outputs
.cache/

# page working data: heavy regenerable intermediates ONLY.
# NOTE: the platform snapshot respects .gitignore — anything ignored here is
# NOT persisted between turns. Tracked on purpose: outputs/ (finished MP4s),
# metadata/<slot>/ (post packages), assets/quran/<slot>/ (sources).
# (**/ prefix so the patterns match at any depth, e.g. mypage/media/raw/)
**/jobs/
**/media/raw/
**/media/official/

# os/editor
.DS_Store
Thumbs.db

# python bytecode from one-shot py_compile checks
__pycache__/
*.py[cod]

# tool scratch images from image_search
image-search/

# stray scratch video at the repo root (real sources live in content-inputs/)
/*.mp4
scan010/clip010_full.mp4
